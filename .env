# =================================
# 필리핀 전자상거래 플랫폼 환경설정 (개발용)
# =================================

# 기본 애플리케이션 설정
APP_NAME="Philippines E-Commerce Platform"
APP_ENV=development
APP_DEBUG=true
APP_KEY=philippines-ecommerce-development-key-2025
APP_URL=http://localhost:3000
APP_PORT=3000

# 필리핀 현지화 설정
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_CURRENCY=PHP
APP_CURRENCY_SYMBOL=₱

# 데이터베이스 설정 (개발용 - SQLite)
DATABASE_URL="file:./database/dev.db"
DB_CONNECTION=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=philippines_ecommerce_dev
DB_USERNAME=dev_user
DB_PASSWORD=dev_password

# Redis 설정 (개발용)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 토큰 설정
JWT_SECRET=philippines-ecommerce-jwt-development-secret-key-2025
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# 이메일 설정 (개발용 - 모킹)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=dev@example.com
MAIL_PASSWORD=dev_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@philippines-ecommerce-dev.com
MAIL_FROM_NAME="Philippines E-Commerce Platform (DEV)"

# SMS 설정 (개발용 - 모킹)
SMS_PROVIDER=semaphore
SMS_API_KEY=dev_sms_api_key
SMS_SENDER_NAME=PhilEcommDev

# 파일 업로드 설정
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,pdf
UPLOAD_PATH=./public/uploads

# =================================
# 결제 게이트웨이 설정 (개발/테스트)
# =================================

# PayMongo (테스트 환경)
PAYMONGO_PUBLIC_KEY=pk_test_development_key
PAYMONGO_SECRET_KEY=sk_test_development_key
PAYMONGO_WEBHOOK_SECRET=whsec_development_secret
PAYMONGO_ENVIRONMENT=sandbox

# Xendit (테스트 환경)
XENDIT_PUBLIC_KEY=xnd_public_development_key
XENDIT_SECRET_KEY=xnd_development_secret_key
XENDIT_WEBHOOK_TOKEN=development_webhook_token
XENDIT_ENVIRONMENT=test

# Dragonpay (테스트 환경)
DRAGONPAY_MERCHANT_ID=dev_merchant_id
DRAGONPAY_SECRET_KEY=dev_secret_key
DRAGONPAY_ENVIRONMENT=sandbox

# GCash (개발 준비)
GCASH_PARTNER_ID=
GCASH_PARTNER_SECRET=
GCASH_ENVIRONMENT=sandbox

# BDO (개발 준비)
BDO_MERCHANT_ID=
BDO_API_KEY=
BDO_ENVIRONMENT=sandbox

# =================================
# ECOUNT ERP 연동 설정 (개발)
# =================================
ECOUNT_API_BASE_URL=https://api.ecount.co.kr
ECOUNT_COMPANY_ID=dev_company_id
ECOUNT_USER_ID=dev_user_id
ECOUNT_API_KEY=dev_api_key
ECOUNT_SYNC_INTERVAL=300000

# ECOUNT 동기화 설정
ECOUNT_AUTO_SYNC=true
ECOUNT_INVENTORY_SYNC=true
ECOUNT_ORDER_SYNC=true
ECOUNT_CUSTOMER_SYNC=true

# =================================
# 필리핀 컴플라이언스 설정 (개발)
# =================================

# BIR (Bureau of Internal Revenue) 개발 설정
BIR_TIN=000-000-000-000
BIR_PERMIT_NUMBER=DEV0000001
BIR_ACCREDITATION_NUMBER=DEV0000001
BIR_ENVIRONMENT=sandbox

# DPA (Data Privacy Act) 설정
DPA_COMPLIANCE_MODE=strict
DPA_DATA_RETENTION_DAYS=365
DPA_CONSENT_REQUIRED=true

# =================================
# 로깅 및 모니터링
# =================================
LOG_LEVEL=debug
LOG_RETENTION_DAYS=30

# Sentry (개발용 - 비활성화)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Analytics (개발용 - 비활성화)
GOOGLE_ANALYTICS_ID=
FACEBOOK_PIXEL_ID=

# =================================
# 보안 설정
# =================================

# CORS 설정
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,http://localhost:5173
CORS_CREDENTIALS=true

# Rate Limiting (개발용 - 관대한 설정)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Session 설정
SESSION_SECRET=philippines-ecommerce-session-development-secret-2025
SESSION_COOKIE_MAX_AGE=86400000
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTP_ONLY=true

# =================================
# 개발도구 설정
# =================================

# API 문서화
SWAGGER_ENABLED=true
SWAGGER_PATH=/api/docs

# 개발 모드 설정
DEV_CORS_ENABLED=true
DEV_MOCK_PAYMENTS=true
DEV_MOCK_SMS=true
DEV_MOCK_EMAIL=true

# =================================
# 클라우드 서비스 (개발용 - 비활성화)
# =================================

# AWS S3 (개발용 - 로컬 저장소 사용)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudinary (개발용 - 비활성화)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =================================
# King's Food 특화 설정 (추가)
# =================================

# 실제 결제 시스템 연동 키 (Production용)
GCASH_API_URL=https://api.gcash.com
GCASH_MERCHANT_ID=your-gcash-merchant-id
GCASH_PUBLIC_KEY=your-gcash-public-key
GCASH_SECRET_KEY=your-gcash-secret-key

MAYA_API_URL=https://pg-sandbox.paymaya.com
MAYA_PUBLIC_KEY=your-maya-public-key
MAYA_SECRET_KEY=your-maya-secret-key

BDO_API_URL=https://api.bdo.com.ph
BDO_MERCHANT_ID=your-bdo-merchant-id
BDO_API_KEY=your-bdo-api-key

BPI_API_URL=https://api.bpi.com.ph
BPI_MERCHANT_ID=your-bpi-merchant-id
BPI_API_KEY=your-bpi-api-key

# 실제 SMS 서비스 키
SEMAPHORE_API_KEY=your-semaphore-api-key
SEMAPHORE_SENDER_ID=KINGSFOOD

TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

GLOBE_APP_ID=your-globe-app-id
GLOBE_APP_SECRET=your-globe-app-secret
GLOBE_SHORT_CODE=21581234

# 웹 푸시 알림 VAPID 키
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# MongoDB Atlas 연결 (Production)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/kingsfood