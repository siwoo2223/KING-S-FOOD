# =================================
# 필리핀 전자상거래 플랫폼 환경설정
# =================================

# 기본 애플리케이션 설정
APP_NAME="Philippines E-Commerce Platform"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:3000
APP_PORT=3000

# 필리핀 현지화 설정
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_CURRENCY=PHP
APP_CURRENCY_SYMBOL=₱

# 데이터베이스 설정
DATABASE_URL="postgresql://username:password@localhost:5432/philippines_ecommerce"
DB_CONNECTION=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=philippines_ecommerce
DB_USERNAME=username
DB_PASSWORD=password

# Redis 설정 (세션, 캐시, 큐)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 토큰 설정
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# 이메일 설정
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# SMS 설정 (필리핀 현지 SMS 서비스)
SMS_PROVIDER=semaphore
SMS_API_KEY=your-sms-api-key
SMS_SENDER_NAME=YourShop

# 파일 업로드 설정
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,pdf
UPLOAD_PATH=./public/uploads

# =================================
# 결제 게이트웨이 설정 (필리핀)
# =================================

# PayMongo (주요 결제수단)
PAYMONGO_PUBLIC_KEY=pk_test_your_public_key
PAYMONGO_SECRET_KEY=sk_test_your_secret_key
PAYMONGO_WEBHOOK_SECRET=whsec_your_webhook_secret
PAYMONGO_ENVIRONMENT=sandbox

# Xendit (대안 결제수단)
XENDIT_PUBLIC_KEY=xnd_public_test_your_public_key
XENDIT_SECRET_KEY=xnd_test_your_secret_key
XENDIT_WEBHOOK_TOKEN=your_webhook_verification_token
XENDIT_ENVIRONMENT=test

# Dragonpay (Over-the-counter 결제)
DRAGONPAY_MERCHANT_ID=your_merchant_id
DRAGONPAY_SECRET_KEY=your_secret_key
DRAGONPAY_ENVIRONMENT=sandbox

# GCash (직접 연동 - 2차 개발)
GCASH_PARTNER_ID=
GCASH_PARTNER_SECRET=
GCASH_ENVIRONMENT=sandbox

# BDO (직접 연동 - 2차 개발)
BDO_MERCHANT_ID=
BDO_API_KEY=
BDO_ENVIRONMENT=sandbox

# =================================
# ECOUNT ERP 연동 설정
# =================================
ECOUNT_API_BASE_URL=https://api.ecount.co.kr
ECOUNT_COMPANY_ID=your_company_id
ECOUNT_USER_ID=your_user_id
ECOUNT_API_KEY=your_api_key
ECOUNT_SYNC_INTERVAL=300000

# ECOUNT 동기화 설정
ECOUNT_AUTO_SYNC=true
ECOUNT_INVENTORY_SYNC=true
ECOUNT_ORDER_SYNC=true
ECOUNT_CUSTOMER_SYNC=true

# =================================
# 필리핀 컴플라이언스 설정
# =================================

# BIR (Bureau of Internal Revenue) 전자영수증
BIR_TIN=your_tin_number
BIR_PERMIT_NUMBER=your_permit_number
BIR_ACCREDITATION_NUMBER=your_accreditation_number
BIR_ENVIRONMENT=sandbox

# DPA (Data Privacy Act) 설정
DPA_COMPLIANCE_MODE=strict
DPA_DATA_RETENTION_DAYS=365
DPA_CONSENT_REQUIRED=true

# =================================
# 로깅 및 모니터링
# =================================
LOG_LEVEL=info
LOG_RETENTION_DAYS=30

# Sentry (에러 트래킹)
SENTRY_DSN=your_sentry_dsn
SENTRY_ENVIRONMENT=development

# Analytics
GOOGLE_ANALYTICS_ID=
FACEBOOK_PIXEL_ID=

# =================================
# 보안 설정
# =================================

# CORS 설정
CORS_ORIGIN=http://localhost:3000,http://localhost:8080
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session 설정
SESSION_SECRET=your-super-secret-session-key
SESSION_COOKIE_MAX_AGE=86400000
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTP_ONLY=true

# =================================
# 개발도구 설정
# =================================

# API 문서화
SWAGGER_ENABLED=true
SWAGGER_PATH=/api/docs

# 개발 모드 설정
DEV_CORS_ENABLED=true
DEV_MOCK_PAYMENTS=true
DEV_MOCK_SMS=true
DEV_MOCK_EMAIL=true

# =================================
# 클라우드 서비스 (선택사항)
# =================================

# AWS S3 (파일 저장소)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudinary (이미지 최적화)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=